# Configuración de Google Gemini
# Obtén tu clave en https://aistudio.google.com/
GEMINI_API_KEY=tu_api_key_aqui

# Apify Token opcional (para scraping en vivo de Instagram)
APIFY_TOKEN=tu_apify_token_aqui

# Puerto y host opcionales
PORT=8085
HOST=127.0.0.1

# Envío de Emails vía Gmail SMTP (Paso 2 de seguimiento)
# Para Gmail, crea una "Contraseña de aplicación" en: https://myaccount.google.com/apppasswords
SMTP_EMAIL=tu_correo@gmail.com
SMTP_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

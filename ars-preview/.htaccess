# ==========================================
# Redirecciones SEO y Configuración de Apache
# ARS Advocats i Assessors
# ==========================================

RewriteEngine On
RewriteBase /

# 1. Forzar HTTPS y canónico www (evita contenido duplicado www vs no-www)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.arsadvocats.com%{REQUEST_URI} [L,R=301]

# 2. Redirecciones 301 de URLs antiguas de WordPress
RewriteRule ^presentacio/?$ /#presentacio [R=301,L,NE]
RewriteRule ^equip/?$ /#equip [R=301,L,NE]
RewriteRule ^especialitats/?$ /#especialitats [R=301,L,NE]
RewriteRule ^contacte/?$ /#contacte [R=301,L,NE]

# 3. Seguridad: Desactivar listado de directorios y proteger archivos sensibles
Options -Indexes

<FilesMatch "^\.(git|github|env|htaccess|gitignore|DS_Store)">
  Require all denied
</FilesMatch>

<FilesMatch "\.(zip|psd|docx|bak|config)$">
  Require all denied
</FilesMatch>

# 4. Cabeceras de Seguridad HTTP
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# 5. Compresión DEFLATE (GZIP)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 6. Caché de recursos estáticos (Core Web Vitals & PageSpeed)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff2|woff)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

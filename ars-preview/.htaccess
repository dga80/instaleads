# ==========================================
# Redirecciones SEO y Configuración de Apache
# ARS Advocats i Assessors
# ==========================================

RewriteEngine On
RewriteBase /

# Forzar HTTPS (seguridad y SEO)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirecciones 301 de URLs antiguas de WordPress a las secciones de la nueva web
RewriteRule ^presentacio/?$ /#presentacio [R=301,L,NE]
RewriteRule ^equip/?$ /#equip [R=301,L,NE]
RewriteRule ^especialitats/?$ /#especialitats [R=301,L,NE]
RewriteRule ^contacte/?$ /#contacte [R=301,L,NE]

# Cabeceras de seguridad y compresión básica
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
